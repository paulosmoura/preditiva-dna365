{
  "name": "preditiva-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:local": "node scripts/setup-local-env.mjs",
    "predev": "pnpm setup:local",
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint src next.config.ts vitest.config.mts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
